Part : <./Data/ships/terran/base_part_terran.rules>/Part
{
	NameKey = "Parts/ReactorSuicide"
	IconNameKey = "Parts/ReactorSuicideIcon"
	ID = emmy.reactor_suicide // Part IDs must always be in the form of "author_name.part_name". If making your own mod, do *not* use "cosmoteer" as your author name, because it may conflict with future vanilla parts.
	EditorGroup = "Utilities"
	DescriptionKey = "Parts/ReactorSuicideDesc"
	Resources //total cost 25,000
	[
		[steel, 32]
		[coil, 82]
		[enriched_uranium, 8]
	]
	AIValueFactor = 5
	Size = [2, 2]
	IsRotateable = false
	SelectionPriority = 0
	SelectionTypeID = "reactors"
	MaxHealth = 2000 //half base health
	AutoDoorMaxPathLength = 5
	TypeCategories = [reactor, provides_power]
	SignificanceToggle = ScorchedToggle
	ReceivableBuffs : ^/0/ReceivableBuffs [ElectronDebuff, ElectronNebula]
	CreateUnderlyingWhenDestroyed = false
	IgnoreRotationForMirroredSelection = true
	EditorIcon
	{
		Texture
		{
			File = "./Data/ships/terran/reactor_small/icon.png"
			SampleMode = Linear
		}
		Size = [56, 56]
	}
	Components : ^/0/Components
	{
		DetonateEffects
		{
			// This just destroys the part, which in turn will trigger the DeathEffects, causing the actual collateral damage.

			Type = TriggeredEffects
			ChainedTo = Turret
			Trigger = Turret
			HitEffects
			[
				{
					Type = Damage
					Damage = 999999
					Filter
					{
						Friendlies = true
						IgnoreInvulnerability = true
					}
				}
			]
		}
		
		IsOperational
		{
			Type = MultiToggle
			Toggles = [NonJunkToggle, ScorchedToggle]
			Mode = All
		}

		NonJunkToggle
		{
			Type = JunkToggle
			OnWhenJunk = false
		}

		ScorchedToggle
		{
			Type = StatusToggle
			StatusType = cosmoteer.scorched
			MinStatusValue = 1
			Invert = true
		}

		BatteryStorage
		{
			Type = ResourceStorage
			ResourceType = battery
			MaxResources = 4000 //half base storage
			StartingResources = &MaxResources
			GiveResourceMediaEffects = &/COMMON_EFFECTS/PowerPickup
			SuppliesResources = true
			MinResourcesPickUp = 1000
			MaxResourcesPickUp = 1000
			ExpectedResourceGenerationToggle = IsOperational
			ExpectedResourceGenerationRate : ../BatteryProducer/ToQuantity
			{
				BaseValue = (&^/0/BaseValue) / (&../../BatteryProducer/Interval/BaseValue)
			}
			ToggleOnResources = 1001
			ToggleOffResources = 1000
			ProvidedValueRange = 0
			ProvidedValuePerResource = 1/1000
		}

		BatteryProducer
		{
			Type = ResourceConverter
			OperationalToggle = IsOperational
			ToStorage = BatteryStorage
			ToQuantity
			{
				BaseValue = 1000
			}
			Interval = { BaseValue=2/3; BuffType=ElectronDebuff; BuffMode=Divide; }
		}

		Graphics
		{
			Type = Graphics
			OperationalToggle = IsOperational
			Location = [1, 1]
			Floor
			{
				Layer = "doodads_high"
				DamageLevels
				[
					{
						File = "./Data/ships/terran/reactor_small/reactor.png"
						Size = [2, 2]
					}
					{
						File = "./Data/ships/terran/reactor_small/reactor_33.png"
						Size = [2, 2]
					}
					{
						File = "./Data/ships/terran/reactor_small/reactor_66.png"
						Size = [2, 2]
					}
				]
			}
			OperationalLighting
			{
				Layer = "lights_add"
				DamageLevels
				[
					{
						AnimationFiles
						[
							"./Data/ships/terran/reactor_small/lights1.png"
							"./Data/ships/terran/reactor_small/lights2.png"
							"./Data/ships/terran/reactor_small/lights3.png"
							"./Data/ships/terran/reactor_small/lights4.png"
							"./Data/ships/terran/reactor_small/lights5.png"
							"./Data/ships/terran/reactor_small/lights6.png"
							"./Data/ships/terran/reactor_small/lights7.png"
							"./Data/ships/terran/reactor_small/lights8.png"
						]
						Size = [2, 2]
						AnimationInterval = 0.065
					}
					{
						AnimationFiles
						[
							"./Data/ships/terran/reactor_small/lights1.png"
							"./Data/ships/terran/reactor_small/lights2.png"
							"./Data/ships/terran/reactor_small/lights3.png"
							"./Data/ships/terran/reactor_small/lights4.png"
							"./Data/ships/terran/reactor_small/lights5.png"
							"./Data/ships/terran/reactor_small/lights6.png"
							"./Data/ships/terran/reactor_small/lights7.png"
							"./Data/ships/terran/reactor_small/lights8.png"
						]
						Size = [2, 2]
						AnimationInterval = 0.065/1.75
					}
					{
						AnimationFiles
						[
							"./Data/ships/terran/reactor_small/lights1.png"
							"./Data/ships/terran/reactor_small/lights2.png"
							"./Data/ships/terran/reactor_small/lights3.png"
							"./Data/ships/terran/reactor_small/lights4.png"
							"./Data/ships/terran/reactor_small/lights5.png"
							"./Data/ships/terran/reactor_small/lights6.png"
							"./Data/ships/terran/reactor_small/lights7.png"
							"./Data/ships/terran/reactor_small/lights8.png"
						]
						Size = [2, 2]
						AnimationInterval = 0.065/2.5
					}
				]
			}
			OperationalDoodad
			{
				Layer = "floors"
				DamageLevels
				[
					{
						AnimationFiles
						[
							"./Data/ships/terran/reactor_small/floor_on1.png"
							"./Data/ships/terran/reactor_small/floor_on2.png"
							"./Data/ships/terran/reactor_small/floor_on3.png"
							"./Data/ships/terran/reactor_small/floor_on4.png"
							"./Data/ships/terran/reactor_small/floor_on5.png"
							"./Data/ships/terran/reactor_small/floor_on6.png"
							"./Data/ships/terran/reactor_small/floor_on7.png"
							"./Data/ships/terran/reactor_small/floor_on8.png"
						]
						Size = [2, 2]
						AnimationInterval = 0.095
					}
					{
						AnimationFiles
						[
							"./Data/ships/terran/reactor_small/floor_on1_33.png"
							"./Data/ships/terran/reactor_small/floor_on2_33.png"
							"./Data/ships/terran/reactor_small/floor_on3_33.png"
							"./Data/ships/terran/reactor_small/floor_on4_33.png"
							"./Data/ships/terran/reactor_small/floor_on5_33.png"
							"./Data/ships/terran/reactor_small/floor_on6_33.png"
							"./Data/ships/terran/reactor_small/floor_on7_33.png"
							"./Data/ships/terran/reactor_small/floor_on8_33.png"
						]
						Size = [2, 2]
						AnimationInterval = 0.095
					}
					{
						AnimationFiles
						[
							"./Data/ships/terran/reactor_small/floor_on1_66.png"
							"./Data/ships/terran/reactor_small/floor_on2_66.png"
							"./Data/ships/terran/reactor_small/floor_on3_66.png"
							"./Data/ships/terran/reactor_small/floor_on4_66.png"
							"./Data/ships/terran/reactor_small/floor_on5_66.png"
							"./Data/ships/terran/reactor_small/floor_on6_66.png"
							"./Data/ships/terran/reactor_small/floor_on7_66.png"
							"./Data/ships/terran/reactor_small/floor_on8_66.png"
						]
						Size = [2, 2]
						AnimationInterval = 0.095
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "./Data/ships/terran/reactor_small/floor_on1.png"
						Size = [2, 2]
					}
					{
						File = "./Data/ships/terran/reactor_small/floor_off_33.png"
						Size = [2, 2]
					}
					{
						File = "./Data/ships/terran/reactor_small/floor_off_66.png"
						Size = [2, 2]
					}
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "./Data/ships/terran/reactor_small/walls.png"
						Size = [2, 2]
					}
					{
						File = "./Data/ships/terran/reactor_small/walls_33.png"
						Size = [2, 2]
					}
					{
						File = "./Data/ships/terran/reactor_small/walls_66.png"
						Size = [2, 2]
					}
				]
			}
			Roof
			{
				Layer = "roofs"
				DamageLevels
				[
					{
						File = "./Data/ships/terran/reactor_small/roof.png"
						NormalsFile = "./Data/ships/terran/reactor_small/roof_normals.png"
						Size = [2, 2]
					}
					{
						File = "./Data/ships/terran/reactor_small/roof_33.png"
						NormalsFile = "./Data/ships/terran/reactor_small/roof_normals_33.png"
						Size = [2, 2]
					}
					{
						File = "./Data/ships/terran/reactor_small/roof_66.png"
						NormalsFile = "./Data/ships/terran/reactor_small/roof_normals_66.png"
						Size = [2, 2]
					}
				]
			}
			OperationalRoofDoodad
			{
				Layer = "roof_doodads"
				DamageLevels
				[
					{
						File = "./Data/ships/terran/reactor_small/roof_glows.png"
						Size = [2, 2]
					}
					{
						File = "./Data/ships/terran/reactor_small/roof_glows_33.png"
						Size = [2, 2]
					}
					{
						File = "./Data/ships/terran/reactor_small/roof_glows_66.png"
						Size = [2, 2]
					}
				]
			}

			OperationalRoofLighting
			{
				Layer = "roof_lights_fancy"
				DamageLevels
				[
					{
						File = "./Data/ships/common/light_blob.png"
						Size = [6, 6]
						Z = 2.5 // Controls the "height" of the light for the purposes of normal mapping.
						VertexColor = [255*1.0,30*1.0, 30*1.0] //base [180*1.0,255*1.0, 77*1.0]
					}
				]
			}
		}

		ReactorHum
		{
			Type = ContinuousEffects
			OperationalToggle = IsOperational
			Location = [1, 1]
			MaxMediaEffectsZoom = 4
			MediaEffects
			[
				: /COMMON_SOUNDS/ReactorHumExterior
				{
					Db = -2
					DynamicVolume : ^/0/DynamicVolume
					{
						ExteriorVolume = .4
					}
				}

				: /COMMON_SOUNDS/ReactorHumInterior
				{
					Sound = "./Data/ships/terran/reactor_small/sounds/reactor_interior_idle.wav"
					Db = -7
				}
			]
		}

		ElectronDebuffToggle
		{
			Type = BuffToggle
			BuffType = ElectronDebuff
		}

		ElectronNebulaEffects
		{
			Type = ContinuousEffects
			OperationalToggle = ElectronDebuffToggle
			Location = [1, 1]
			MediaEffectsIntensityFactor = { BaseValue=1; BuffType=ElectronNebula; BuffMode=Multiply; }
			MediaEffects
			[
				&<./Data/nebulas/electron/particles/electron_reactor_light.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					Sound = "./Data/nebulas/electron/sounds/electron_cloud_reactor_weaken.wav"
					Volume = 1
					MaxConcurrentVolume = &Volume
					MaxConcurrent = 1
				}
			]
		}

		ElectronNebulaShipEffects
		{
			Type = ContinuousEffects
			OperationalToggle = ElectronDebuffToggle
			Location = [1, 1]
			ParentToShip = true
			MediaEffectsIntensityFactor = { BaseValue=1; BuffType=ElectronNebula; BuffMode=Multiply; }
			MediaEffects
			[
				&<./Data/nebulas/electron/particles/electron_reactor_sizzle.rules>
			]
		}

		BatterySprites
		{
			Type = ResourceSprites
			Location = [1, 1]
			ResourceStorage = BatteryStorage
			Layer = "doodads_high"
			Round = Down
			ResourceLevels
			[
				{
					File = "./Data/ships/terran/reactor_small/batteries1.png"
					Offset = [0.2525, -0.5]
					Size = [1, 1]
				}
				{
					File = "./Data/ships/terran/reactor_small/batteries2.png"
					Offset = [0.2525, -0.5]
					Size = [1, 1]
				}
				{
					File = "./Data/ships/terran/reactor_small/batteries3.png"
					Size = [2, 2]
				}
				{
					File = "./Data/ships/terran/reactor_small/batteries4.png"
					Size = [2, 2]
				}
				{
					File = "./Data/ships/terran/reactor_small/batteries5.png"
					Size = [2, 2]
				}
				{
					File = "./Data/ships/terran/reactor_small/batteries6.png"
					Size = [2, 2]
				}
				{
					File = "./Data/ships/terran/reactor_small/batteries7.png"
					Size = [2, 2]
				}
				{
					File = "./Data/ships/terran/reactor_small/batteries8.png"
					Size = [2, 2]
				}
			]
		}

		ScorchedTrigger
		{
			Type = ToggleTrigger
			Toggle = ScorchedToggle
			TriggerWhenOn = false
		}

		ScorchedEffects
		{
			Type = TriggeredEffects
			Trigger = ScorchedTrigger
			Location = [1, 1]
			HitEffects
			[
				{
					Type = ExplosiveResourceDrain
					ResourceType = battery
					TotalDrain = { BaseValue = 50000; EffectScaleExponent = 1 }
					Radius = 8
					Delay = .05
					ExpandDuration = .1
					ExpandStartRadius = 2
					ExpandLoss = 100%
					Filter
					{
						Friendlies = true
					}
					MediaEffectsOnDrainFactor = .00025
					MediaEffectsOnDrain
					[
						&<./Data/shots/missile_emp/particles/missile_emp_hit_sizzle.rules>
						&<./Data/shots/missile_emp/particles/missile_emp_lightning.rules>
						&<./Data/shots/missile_emp/particles/missile_emp_drain.rules>

						: /BASE_SOUNDS/AudioExterior
						{
							RandomSounds = ["./Data/ships/terran/reactor_small/sounds/disruptor_discharge_01.wav",
											"./Data/ships/terran/reactor_small/sounds/disruptor_discharge_02.wav",
											"./Data/ships/terran/reactor_small/sounds/disruptor_discharge_03.wav",
											"./Data/ships/terran/reactor_small/sounds/disruptor_discharge_04.wav"]
							Volume = 1
							SpeedVariation = .15
						}
					]
				}
			]
			MediaEffects : /COMMON_EFFECTS/MedPartScorched
			[
				&<./Data/shots/missile_emp/particles/missile_emp_hit_orb.rules>
				&<./Data/shots/missile_emp/particles/missile_emp_hit_bolts.rules>
				&<./Data/shots/missile_emp/particles/missile_emp_hit_shockwave.rules>
			]
		}

		DestroyedEffects
		{
			Type = DeathEffects
			Location = [1, 1]

			MediaEffects
			[
				&<./Data/ships/terran/reactor_small/particles/reactor_explode_small.rules>
				&<./Data/ships/terran/reactor_small/particles/reactor_explode_flash_small.rules>
				&<./Data/ships/terran/reactor_small/particles/reactor_shockwave_small.rules>
				&<./Data/common_effects/particles/explosions/med_part_explode_debris.rules>
				&<./Data/common_effects/particles/explosions/big_part_explode_smoke.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds = ["./Data/ships/terran/reactor_small/destroyed/reactor_destroyed_01.wav", "./Data/ships/terran/reactor_small/destroyed/reactor_destroyed_02.wav", "./Data/ships/terran/reactor_small/destroyed/reactor_destroyed_03.wav"]
					Volume = 1.25 //base 1
					SpeedVariation = .25
				}

				: /BASE_SHAKE
				{
					ShakeAmount = .5 //base .25
					Duration = 3 //base 2
				}
			]

			HitEffects
			[
				{
					Type = ExplosiveDamage
					TotalDamage = 500000 //base 90000
					Radius = 30 //base 6
					Delay = .05
					ExpandDuration = 1 //base .1
					ExpandStartRadius = 7
					ExpandLoss = 50% //base 100%
					StatusType = cosmoteer.fire
					StatusChancePerNDamage = 50%
					StatusValue = 1
					StatusValueType = Interpolated
					ImpulsePerNDamage = 10 //base 10
					NDamage = 1000
					Filter
					{
						OperationalHealth = true
						StructuralHealth = false
						Friendlies = true
					}
				}
				{
					Type = ExplosiveDamage
					TotalDamage = 200000 //base 20000
					Radius = 15 //base 4
					Delay = .05
					ExpandDuration = .8 //base .05
					ExpandStartRadius = 2
					ExpandLoss = 50% //base 100%
					ImpulsePerNDamage = 5 //base 5
					NDamage = 1000
					Filter
					{
						OperationalHealth = false
						StructuralHealth = true
						Friendlies = true
					}
				}
			]
		}

		Indicators
		{
			Type = IndicatorSprites
			Location = [1, 1]
			Indicators
			[
				// Scorched
				{
					Toggle = ScorchedToggle
					AtlasSprite = &/INDICATORS/Scorched
					HidesIndicators = [1,2]
				}
				// Out of power.
				{
					Toggle = BatteryStorage
					AtlasSprite
					{
						File = &/INDICATORS/NoPower
						Size = [1, 1]
					}
				}
				// Resetting from overclock
				//Crashes without a third option so just duplicating this over
				{
					Toggle = NonJunkToggle
					AtlasSprite : /INDICATORS/OverclockReset
					{
						Size = [1, 1]
					}
				}
			]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "./Data/ships/terran/reactor_small/blueprints.png"
			Size = [2, 2]
		}
		
		// Gun targeting for suicide
		FireModeToggle
		{
			Type = UIToggle
			ToggleID = "fire_mode"
			Default = 1
			ToggledOnChoices = [0, 1, 2]
		}
		AutoTargetToggle
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnModes = [1, 2]
		}
		AutoFireToggle
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnMode = 2
		}
		
		Turret //Allows the weapon to be shot by AI, causing it to explode.
		{
			Type = TurretWeapon // This has an arc of 0, but we don't want to use FixedWeapon because that will only shoot at things directly in the LOS.
			Location = [.5, .5]
			Rotation = -90d
			OperationalToggle = IsOperational
			AutoFireToggle = AutoFireToggle
			FireInterval = 0 // Uses common reload timer.
			FiringArc = 0d;
			ValidArc = 360d;
			FireThresholdAngle = 360d;
			RotateSpeed = 0d
			AllowFireWithBlockedLOS = true 
			IgnoreFriendlyShipLowLOSChecks = true //Attempt to remove LOS for blast
			Emitter = BulletEmitter // Doesn't actually fire; only used for targeting.
			FirePermissionToggle = FireModeToggle
			AIFirepowerRating = 3200
			
			AutoTargets
			[
				{
					TargetType = ShipParts
					Toggle = AutoTargetToggle
				}
			]

			BlueprintArcSprite
			{
				Texture = &/INDICATORS/WeaponArc
				Size = [0, 1.5]
				Color = [255, 0, 0, 63]
			}
			BlueprintArcRadius = 10
			BlueprintArcSpriteSegments = 64

			CoverageSectorArc
			{
				Texture = &/INDICATORS/VerticalGradient
				VertexColor = [255, 255, 255, 51]
				QuadCount = 64
			}
		}
		//Required for the part to actually shoot. I don't know why since it doesn't spawn the bullet anyways.
		BulletEmitter 
		{
			Type = BulletEmitter
			ChainedTo = Turret
			FireTrigger = Turret
			GetTargetFrom = Turret
			Location = [1, 0]
			OperationalToggle = IsOperational
			FireDelay = .4
			Bullet = &<rs_shot.rules>
		}
	}

	Stats
	{
		PowerGeneration = (&~/Part/Components/BatteryProducer/ToQuantity/BaseValue) / (&~/Part/Components/BatteryProducer/Interval/BaseValue) / 1000
		BatterySize = (&~/Part/Components/BatteryStorage/MaxResourcesPickUp) / 1000
		BatteryFillTime = 0
		PowerCapacity = (&~/Part/Components/BatteryStorage/MaxResources) / 1000
	}
}